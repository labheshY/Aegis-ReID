# Example environment variables for production
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Optional: backend default video path
# DEFAULT_VIDEO_PATH=/app/data/videos/test_short.mp4

# Optional secret used for any encryption of sensitive fields (not yet implemented)
# SECRET_KEY=your-very-secret-value
